Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

%post
    pip install --no-cache-dir \
        "transformers==4.56.2" \
        "trl==0.22.1" \
        "peft==0.17.1" \
        "accelerate==1.10.1" \
        "datasets==4.1.1" \
        "bitsandbytes==0.47.0"

%environment
    export PYTHONUNBUFFERED=1
